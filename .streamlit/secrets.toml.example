# ─────────────────────────────────────────────────────────────────────
#  PLANTILLA — copiá como  .streamlit/secrets.toml  (no se sube al repo).
#  En Streamlit Community Cloud: App → Settings → Secrets.
#  ⚠️ Nunca pongas los valores reales en este archivo de ejemplo.
# ─────────────────────────────────────────────────────────────────────

[sheets]
sheet_id = "ID_DE_LA_HOJA_DE_GOOGLE"

# ── Login con Google (mismo cliente OAuth que el Dashboard Operativo) ──
[auth]
redirect_uri = "https://wfm-un-scalalearning.streamlit.app/oauth2callback"
# cadena aleatoria larga:  python3 -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = "REEMPLAZAR_POR_CADENA_ALEATORIA_LARGA"

[auth.google]
client_id = "xxxxxxxxxxxx.apps.googleusercontent.com"
client_secret = "REEMPLAZAR_POR_EL_SECRETO_DE_GOOGLE"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# ── Correos con acceso (uno por línea, entre comillas) ──
# Alternativa: en vez de 'emails', usar  domains = ["scalalearning.com"]
[access]
emails = [
    "persona1@scalalearning.com",
    "persona2@scalalearning.com",
]
